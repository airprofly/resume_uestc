# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# LaTeX source files
*.tex    text eol=lf
*.cls    text eol=lf
*.sty    text eol=lf
*.bib    text eol=lf

# Config / meta files
*.md          text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Binary: compiled output
*.pdf    binary

# Binary: images
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.svg    binary
